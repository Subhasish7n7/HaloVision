{
  "model_version": "halovision_v2",
  "base_model": "yolo26s",
  "base_checkpoint": "yolo26s.pt",
  "dataset_version": "halovision_v2",
  "dataset_yaml": "ml/training/datasets/halovision_v2/halovision_v2.yaml",
  "output_dir": "models/yolo26_halovision_v2",
  "training_config": {
    "epochs": 100,
    "batch": 16,
    "imgsz": 640,
    "optimizer": "auto",
    "lr0": 0.01,
    "lrf": 0.01,
    "momentum": 0.937,
    "weight_decay": 0.0005,
    "warmup_epochs": 3.0,
    "warmup_momentum": 0.8,
    "warmup_bias_lr": 0.1,
    "device": "cpu",
    "workers": 4,
    "cos_lr": false,
    "close_mosaic": 10,
    "amp": true,
    "seed": 0,
    "patience": 50,
    "save_period": 10,
    "freeze": 0,
    "exist_ok": true,
    "pretrained": true
  },
  "transfer_learning": {
    "strategy": "freeze_backbone_then_finetune",
    "phase1_freeze": 10,
    "phase1_epochs": 20,
    "phase1_lr": 0.001,
    "phase2_unfreeze_epoch": 20,
    "phase2_epochs": 80,
    "phase2_lr": 0.001
  },
  "total_classes": 95,
  "coco_classes": 80,
  "halovision_classes": 15,
  "new_class_ids": {
    "80": "wheelchair",
    "81": "white_cane",
    "82": "crutches",
    "83": "guide_dog",
    "84": "crosswalk",
    "85": "curb",
    "86": "pothole",
    "87": "stairs",
    "88": "escalator",
    "89": "elevator",
    "90": "door",
    "91": "entrance",
    "92": "exit",
    "93": "bollard",
    "94": "road_barrier"
  },
  "backward_compatibility": {
    "note": "All 80 COCO class IDs (0-79) are preserved. Existing HaloVision rule_engine, safety.py, and DANGEROUS_CLASSES references remain valid.",
    "breaking_changes": "none"
  }
}
