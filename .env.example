# =============================================================================
# HaloVision Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# REQUIRED in production: a random secret string for JWT signing
# Generate with: openssl rand -hex 32
SECRET_KEY=

# REQUIRED: PostgreSQL connection URL
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# REQUIRED in production: set to "production" to enforce strict security
APP_ENV=development

# CORS: comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Azure Speech TTS (optional — falls back to edge-tts / pyttsx3)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Admin account (seeded on first run if ADMIN_PASSWORD is set)
ADMIN_NAME=Halo Admin
ADMIN_EMAIL=admin@halovision.local
ADMIN_PASSWORD=
